---
import Layout from '../layouts/Layout.astro'
import { PostList } from '../components/PostList'
import { getPosts, toPostSummaries } from '../lib/blog'

export const prerender = true

const posts = toPostSummaries(await getPosts())
---

<Layout title="記事一覧 | Astro" modeLabel="一覧は SSG（markdown の Content Collections）">
  <PostList client:load posts={posts} />
  <p class="muted">
    リクエスト時SSRの比較用: <a href="/live">/live</a>
  </p>
</Layout>
