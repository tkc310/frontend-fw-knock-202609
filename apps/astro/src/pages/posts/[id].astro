---
import Layout from '../../layouts/Layout.astro'
import { CommentsToggle } from '../../components/CommentsToggle'
import {
  fetchAuthor,
  fetchComments,
  fetchPost,
  fetchPosts,
  parsePostId,
} from '../../lib/blog'

export async function getStaticPaths() {
  const posts = await fetchPosts()
  return posts.map((post) => ({
    params: { id: String(post.id) },
  }))
}

const postId = parsePostId(Astro.params.id)
if (postId === null) {
  return Astro.redirect('/')
}

const post = await fetchPost(postId)
if (post === null) {
  return Astro.redirect('/')
}

const [comments, author] = await Promise.all([
  fetchComments(post.id),
  fetchAuthor(post.userId),
])
---

<Layout title={`${post.title} | Astro`} modeLabel="詳細は getStaticPaths による SSG">
  <a class="back-link" href="/">← 一覧へ</a>
  <article class="card">
    <p class="muted">
      {author === null ? '不明な著者' : `${author.name} (@${author.username})`}
    </p>
    <h1>{post.title}</h1>
    <p>{post.body}</p>
  </article>
  <CommentsToggle client:load comments={comments} />
</Layout>
