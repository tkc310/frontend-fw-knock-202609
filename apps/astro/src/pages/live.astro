---
import Layout from '../layouts/Layout.astro'
import { PostList } from '../components/PostList'
import { getPosts, toPostSummaries } from '../lib/blog'

export const prerender = false

const posts = toPostSummaries(await getPosts())
const renderedAt = new Date().toISOString()
---

<Layout
  title="ライブ一覧 | Astro"
  modeLabel={`prerender = false の SSR（描画時刻 ${renderedAt}）`}
>
  <p class="muted">
    記事データはビルド時の Content Collections です。このページだけリクエストごとに HTML を組み立てます。
  </p>
  <PostList client:load posts={posts} />
</Layout>
